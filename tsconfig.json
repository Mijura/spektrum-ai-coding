{
    "compilerOptions": {
      "target": "es2016",  
      "jsx": "react",               
      "module": "commonjs",                          
      "esModuleInterop": true,                            
      "forceConsistentCasingInFileNames": true,  
      "strict": true, 
      "skipLibCheck": true,
      "outDir": "build",
      "baseUrl": "./",
      "paths": {
        "@adapters/*": ["src/adapters/*"],
        "@domain/*": ["src/domain/*"],
        "@dto/*": ["src/dto/*"],
        "@entity/*": ["src/entity/*"],
        "@errors/*": ["src//errors/*"],
        "@repositories/*": ["src/repositories/*"],
        "@schemas/*": ["src/schemas/*"],
        "@models/*": ["src/models/*"],
        "@use-cases/*": ["src/use-cases/*"],
        "@utils/*": ["src/utils/*"],
        "@infrastructure/*": ["src/infrastructure/*"],
        "@application/*": ["src/application/*"],
        "@project-templates/*": ["templates/*"]
      }                    
    },
    "exclude": ["node_modules", "dist", "src/application/templates/*", "projects", "build"]
  }